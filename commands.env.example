# The instance's details for the commands in commands.txt. Copy to commands.env, which is gitignored,
# fill it in, and load it in each new terminal with: source commands.env
SPORTSARB_HOST=203.0.113.10                 # Public IP of the instance. It changes when the instance is started.
SPORTSARB_USER=ubuntu
SPORTSARB_KEY=~/.ssh/sportsarb.pem          # SSH key for the instance.
SPORTSARB_INSTANCE=i-0123456789abcdef0      # EC2 instance id.
SPORTSARB_SECURITY_GROUP=sg-0123456789abcdef0
SPORTSARB_REGION=us-east-1
